# Konfigurasi Environment Sahabat SOS Mobile (Flutter)
# Jalankan aplikasi dengan konfigurasi ini:
# flutter run --dart-define-from-file=.env
# Untuk build release APK / App Bundle:
# flutter build appbundle --dart-define-from-file=.env

# API Base URL (HTTPS di production)
API_BASE_URL=https://api.sahabatsos.id/api
STORAGE_URL=https://api.sahabatsos.id/storage

# WebSocket Laravel Reverb (Pusher Protocol)
REVERB_HOST=api.sahabatsos.id
REVERB_PORT=443
REVERB_APP_KEY=sahabat-sos-app-key
REVERB_APP_CLUSTER=mt1
REVERB_ENCRYPTED=true

# Mapbox Access Token (Opsional jika menggunakan OpenStreetMap/OSRM)
MAPBOX_ACCESS_TOKEN=
